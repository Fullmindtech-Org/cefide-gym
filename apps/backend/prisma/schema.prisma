generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Frecuencia {
  CLASE_SUELTA
  UNA_VEZ
  DOS_VECES
  TRES_VECES
  CUATRO_VECES
  CINCO_VECES
  LIBRE
  BECADO
}

enum TipoPago {
  PAGO
  ANULACION
}

enum Rol {
  ADMIN
  PROFESOR
}

enum EstadoIngreso {
  VERDE
  AMARILLO
  ROJO
}

enum ModoRenovacion {
  MANUAL
  AUTOMATICO
}

enum ProgramacionRenovacion {
  ULTIMO_DIA_MES
  PRIMER_LUNES_HABIL
}

enum EstadoRenovacion {
  EN_PROCESO
  COMPLETADA
  FALLIDA
}

enum OrigenRenovacion {
  MANUAL
  AUTOMATICA
}

model Actividad {
  id            String                 @id @default(cuid())
  nombre        String                 @unique
  activo        Boolean                @default(true)
  inscripciones InscripcionActividad[]
  profesores    Profesor[]             @relation("ProfesorActividades")
  creadoEn      DateTime               @default(now())
}

model Alumno {
  id            String                 @id @default(cuid())
  dni           String                 @unique
  nombre        String
  apellido      String
  telefono        String?
  direccion       String?
  fechaNacimiento DateTime?
  fechaIngreso    DateTime?
  observaciones   String?
  activo        Boolean                @default(true)
  inscripciones InscripcionActividad[]
  ingresos      Ingreso[]
  pagos         Pago[]
  creadoEn      DateTime               @default(now())
  actualizadoEn DateTime               @updatedAt

  @@index([dni])
  @@index([activo])
}

model InscripcionActividad {
  id           String     @id @default(cuid())
  alumnoId     String
  alumno       Alumno     @relation(fields: [alumnoId], references: [id])
  actividadId  String
  actividad    Actividad  @relation(fields: [actividadId], references: [id])
  frecuencia   Frecuencia
  clasesTotal  Int
  clasesUsadas Int        @default(0)
  pagado       Boolean    @default(false)
  fechaPago    DateTime?
  pagos        Pago[]
  ingresos     Ingreso[]
  creadoEn     DateTime   @default(now())

  @@unique([alumnoId, actividadId])
  @@index([alumnoId])
  @@index([actividadId])
}

model Profesor {
  id          String      @id @default(cuid())
  dni         String      @unique
  nombre      String
  apellido    String
  usuario     Usuario?
  actividades Actividad[] @relation("ProfesorActividades")
}

model Usuario {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  rol           Rol       @default(PROFESOR)
  profesorId    String?   @unique
  profesor      Profesor? @relation(fields: [profesorId], references: [id])
  creadoEn      DateTime  @default(now())
  tokenVersion  Int       @default(0)
  renovaciones  EjecucionRenovacion[] @relation("UsuarioRenovacion")
  cambiosRenovacion AuditoriaConfiguracionRenovacion[] @relation("UsuarioCambioRenovacion")
}

model Ingreso {
  id            String                @id @default(cuid())
  alumnoId      String
  alumno        Alumno                @relation(fields: [alumnoId], references: [id])
  inscripcionId String?
  inscripcion   InscripcionActividad? @relation(fields: [inscripcionId], references: [id])
  fechaHora     DateTime              @default(now())
  estado        EstadoIngreso
  molinete      Int                   @default(1)

  @@index([alumnoId])
  @@index([inscripcionId])
  @@index([fechaHora])
}

model Pago {
  id            String                @id @default(cuid())
  alumnoId      String
  alumno        Alumno                @relation(fields: [alumnoId], references: [id])
  inscripcionId String?
  inscripcion   InscripcionActividad? @relation(fields: [inscripcionId], references: [id])
  tipo          TipoPago
  fecha         DateTime              @default(now())
  nota          String?

  @@index([alumnoId])
  @@index([inscripcionId])
  @@index([fecha])
}

model ConfigSistema {
  id               String    @id @default("global")
  clasesGracia     Int       @default(5)
  diaVencimiento   Int       @default(5)
  clasesUnaVez     Int       @default(5)
  clasesDosVeces   Int       @default(9)
  clasesTresVeces  Int       @default(13)
  clasesCuatroVeces Int      @default(17)
  clasesCincoVeces Int       @default(21)
  clasesSuelta     Int       @default(1)
  clasesLibre      Int       @default(30)
  clasesBecado     Int       @default(30)
  tiempoVerde      Int       @default(4)
  tiempoAmarillo   Int       @default(5)
  tiempoRojo       Int       @default(6)
  reingresoVentanaMinutos Int @default(180)
  codigosComodin   String    @default("00000000,99999999")
  ultimaRenovacion DateTime?
  modoRenovacion ModoRenovacion @default(MANUAL)
  programacionRenovacion ProgramacionRenovacion @default(ULTIMO_DIA_MES)
  // Impide que al activar el automático se ejecute retrospectivamente un período anterior.
  automaticoDesde DateTime?
}

model RenovacionMensual {
  id String @id @default(cuid())
  periodo String @unique
  estado EstadoRenovacion @default(EN_PROCESO)
  iniciadaEn DateTime @default(now())
  finalizadaEn DateTime?
  totalEncontradas Int @default(0)
  renovadas Int @default(0)
  omitidas Int @default(0)
  errores Int @default(0)
  errorMensaje String?
  ejecuciones EjecucionRenovacion[]

  @@index([estado])
}

model EjecucionRenovacion {
  id String @id @default(cuid())
  renovacionId String
  renovacion RenovacionMensual @relation(fields: [renovacionId], references: [id], onDelete: Cascade)
  origen OrigenRenovacion
  usuarioId String?
  usuario Usuario? @relation("UsuarioRenovacion", fields: [usuarioId], references: [id], onDelete: SetNull)
  iniciadaEn DateTime @default(now())
  finalizadaEn DateTime?
  estado EstadoRenovacion @default(EN_PROCESO)
  totalEncontradas Int @default(0)
  renovadas Int @default(0)
  omitidas Int @default(0)
  errores Int @default(0)
  errorMensaje String?

  @@index([renovacionId])
  @@index([usuarioId])
}

model AuditoriaConfiguracionRenovacion {
  id String @id @default(cuid())
  usuarioId String?
  usuario Usuario? @relation("UsuarioCambioRenovacion", fields: [usuarioId], references: [id], onDelete: SetNull)
  modoAnterior ModoRenovacion
  modoNuevo ModoRenovacion
  programacionAnterior ProgramacionRenovacion
  programacionNueva ProgramacionRenovacion
  creadoEn DateTime @default(now())

  @@index([creadoEn])
  @@index([usuarioId])
}
